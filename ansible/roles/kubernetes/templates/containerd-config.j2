{{ ansible_managed | comment }}
disabled_plugins = {{ containerd.disabled_plugins }}

#root = "/var/lib/containerd"
#state = "/run/containerd"
#subreaper = true
#oom_score = 0

#[grpc]
#  address = "/run/containerd/containerd.sock"
#  uid = 0
#  gid = 0

{%- if containerd.debug.enabled %}
[debug]
  address = "/run/containerd/debug.sock"
  uid = 0
  gid = 0
  level = "{{ containerd.debug.level }}"
{% endif -%}

{%- if containerd.cri_addon.enabled %}
[plugins."{{ containerd.cri_addon.plugin }}"]
  sandbox_image = "{{ containerd.cri_addon.sandbox_image }}"
{% endif -%}
