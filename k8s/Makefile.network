# Network add-on for cluster
#    Calico was never tested, this supports flannel
#
# Usage:
#    export CLUSTER_NETWORK=flannel
#    make cluster_network

.PHONY: cluster_network

cluster_network: imports/$(CLUSTER_NETWORK)

imports/flannel.yaml: imports/flannel-$(VERSION_FLANNEL).yaml
	ln -s $(notdir $<) $@
imports/flannel-$(VERSION_FLANNEL).yaml:
	curl -sLo $@ https://raw.githubusercontent.com/flannel-io/flannel/$(VERSION_FLANNEL)/Documentation/kube-flannel.yml
	sed -i \
	  -e 's/"Type": "vxlan"/"Type": "host-gw"/' \
	  -e 's/"EnableNFTables": false/"EnableNFTables": $(ENABLE_NFT)/' \
	  -e 's+"Network": "10.244.0.0/16"+"Network": "$(CLUSTER_CIDR)"+' $@
